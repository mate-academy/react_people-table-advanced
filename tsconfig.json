{
  "extends": "@mate-academy/students-ts-config",
  "include": [
    "cypress.config.ts",
    "src"
  ],
  "compilerOptions": {
    "sourceMap": false,
    "types": ["node", "cypress"],
    "baseUrl": ".",
    "paths": {
      "@app/*":       ["src/app/*"],
      "@pages/*":     ["src/pages/*"],
      "@widgets/*":     ["src/widgets/*"],
      "@entities/*":     ["src/entities/*"],
      "@shared/*":     ["src/shared/*"],
    }
  }
}
